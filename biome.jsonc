{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "linter": {
    "rules": {
      "suspicious": {
        "useAwait": "off",
        "noEmptyBlockStatements": "off"
      }
    }
  },
  "overrides": [
    {
      // Public package entry points: re-exporting is their job. The
      // workaround file re-exports on purpose too — that is what makes Convex
      // install the gRPC peers into the Node action (see example/README.md).
      "includes": [
        "src/client/index.ts",
        "src/client/sender.ts",
        "example/convex/_workaround.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ],
  "files": {
    // _generated/ is written by `convex codegen`; example/ is a sample app
    // with its own generated tree.
    "includes": ["!**/_generated", "!dist", "!bun.lock"]
  }
}
